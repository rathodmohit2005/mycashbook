Options -MultiViews
RewriteEngine On

# HTTPS Fix - Changed from HTTPS to HTTP for localhost development
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^localhost [NC]
RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

# 1. Favicon fix
RewriteRule ^favicon\.ico$ assets/icons/icon.svg [L]

# 2. External redirect: .php to clean URL
# Using REQUEST_URI ensures we only get the web path, never the server path
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} ^(.+)\.php$
RewriteRule ^ %1 [R=302,L]

# 3. Internal rewrite: clean URL back to .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]
